                    <div class="font-bold text-gray-700 mb-2">子分类</div>
                    <div class="space-y-1">
                        ${["A级景区","乡村旅游","农业采摘","露营体验","非遗体验","咖啡文创","特色文化","工业旅游","拓展体验"].map(cat => `<div data-sub="${cat}" class="subcat-item px-3 py-2 rounded-lg cursor-pointer hover:bg-blue-50 ${activeSub===cat ? 'bg-blue-100 text-blue-700 font-semibold' : ''}">${cat}</div>`).join('')}
                    </div>
                </div>
                <div class="flex-1 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="resourceCards"></div>
            </div>
        `;
        document.getElementById('dynamicContent').innerHTML = html;
        function renderCards() {
            let currentSub = document.querySelector('.subcat-item.bg-blue-100')?.getAttribute('data-sub') || "A级景区";
            let filtered = resources.filter(r => r.subcat === currentSub);
            const container = document.getElementById('resourceCards');
            container.innerHTML = filtered.map(item => `
                <div class="bg-white rounded-xl shadow overflow-hidden card-hover cursor-pointer" data-id="${item.id}">
                    <img src="${item.img}" class="w-full h-40 object-cover" alt="${item.name}" onerror="this.src='https://picsum.photos/id/39/400/300'">
                    <div class="p-4">
                        <div class="flex items-center gap-2"><span class="text-2xl">${item.icon}</span><div class="font-bold text-lg">${item.name}</div></div>
                        <div class="text-sm text-gray-500">${item.area} · ${item.type}</div>
                        <div class="mt-2 text-sm line-clamp-2">${item.desc.substring(0, 80)}${item.desc.length>80?'...':''}</div>
                        <div class="mt-2 flex justify-between items-center"><span class="text-xs text-gray-400">🔥 热度 ${item.heat}</span><span class="text-blue-500 text-xs">查看详情 →</span></div>
                    </div>
                </div>
            `).join('');
            document.querySelectorAll('#resourceCards .card-hover').forEach(card => {
                const id = parseInt(card.getAttribute('data-id'));
                card.onclick = () => showModal(resources.find(r=>r.id===id));
            });
        }
        renderCards();
        document.querySelectorAll('.subcat-item').forEach(el => {
            el.onclick = () => {
                document.querySelectorAll('.subcat-item').forEach(e=>e.classList.remove('bg-blue-100','text-blue-700','font-semibold'));
                el.classList.add('bg-blue-100','text-blue-700','font-semibold');
                renderCards();
            };
        });
    }

    // 模态框功能
    function showModal(item) {
        document.getElementById('modalTitle').innerText = item.name;
        let seasonHtml = item.season ? `<div><span class="font-semibold">最佳季节：</span>${item.season}</div>` : '';
        let imgHtml = `<img src="${item.img}" class="w-full h-48 object-cover rounded-lg mb-3" alt="${item.name}" onerror="this.src='https://picsum.photos/id/39/400/300'">`;
        document.getElementById('modalContent').innerHTML = `
            ${imgHtml}
            <div><span class="font-semibold">区域：</span>${item.area}</div>
            <div><span class="font-semibold">类型：</span>${item.type}</div>
            <div><span class="font-semibold">热度指数：</span>${item.heat}</div>
            ${seasonHtml}
            <div class="mt-2"><span class="font-semibold">简介：</span>${item.desc}</div>
            <div class="mt-2 text-xs text-gray-400">🎯 建议游玩时长：1-2小时</div>
        `;
        document.getElementById('detailModal').classList.remove('hidden');
    }
    function closeModal() { document.getElementById('detailModal').classList.add('hidden'); }
    document.getElementById('closeModalBtn').onclick = closeModal;
    document.getElementById('closeModalFooter').onclick = closeModal;
    document.getElementById('detailModal').onclick = (e) => { if(e.target === document.getElementById('detailModal')) closeModal(); };

    // 占位页面
    function renderPlaceholder(title) {
        document.getElementById('dynamicContent').innerHTML = `<div class="bg-white rounded-2xl shadow p-10 text-center"><h2 class="text-2xl font-bold">${title}</h2><p class="text-gray-500 mt-2">功能建设中，敬请期待...</p></div>`;
    }

    // 导航映射
    const navMap = {
        resource: renderResourcePage,
        integration: renderIntegrationPage,
        analysis: () => renderPlaceholder("口碑分析功能开发中")
    };
    document.querySelectorAll('.category-nav').forEach(nav => {
        nav.onclick = () => {
            document.querySelectorAll('.category-nav').forEach(n=>n.classList.remove('nav-active'));
            nav.classList.add('nav-active');
            const cat = nav.getAttribute('data-category');
            if(navMap[cat]) navMap[cat]();
            else renderPlaceholder("功能开发中");
        };
    });
    renderResourcePage();

    // 导出PDF/JSON
    document.getElementById('exportPdfBtn').onclick = async () => {
        const element = document.querySelector('.main-content');
        const btn = this;
        btn.innerText = '⏳ 生成中...';
        try {
            const canvas = await html2canvas(element, { scale: 2, backgroundColor: '#ffffff' });
            const imgData = canvas.toDataURL('image/png');
            const { jsPDF } = window.jspdf;
            const pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
            const pdfWidth = pdf.internal.pageSize.getWidth();
            const pdfHeight = (canvas.height * pdfWidth) / canvas.width;
            pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
            pdf.save('莱山文旅南拓整合报告.pdf');
        } catch(e) { alert('生成失败'); }
        btn.innerText = '📥 下载PDF报告';
    };
    document.getElementById('exportJsonBtn').onclick = () => {
        let data = { resources, painIntensities, painTags, painSummaries, praiseIntensities, praiseTags, praiseSummaries };
        let blob = new Blob([JSON.stringify(data,null,2)], {type:'application/json'});
        let a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'laishan_data.json'; a.click();
    };
</script>
</body>
</html>
